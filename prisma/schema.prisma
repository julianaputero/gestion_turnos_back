generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Debe coincidir con USER_ROLES (src/constants/roles.constants.js) y con el front-end.
enum Role {
  gestion
  profesional
}

model User {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Turnos atendidos por este usuario (solo aplica a profesionales).
  turnos Turno[]

  /// Pacientes asignados a este usuario (solo aplica a profesionales).
  pacientesAsignados PacienteProfesional[]

  /// Ficha del profesional (solo existe para usuarios con rol profesional).
  profesional Profesional?

  /// Mensajes enviados a pacientes en nombre de este profesional.
  mensajes Mensaje[]

  @@map("users")
}

/// Debe coincidir con MODALIDADES (src/constants/profesionales.constants.js) y con el front-end.
enum Modalidad {
  presencial
  virtual
}

/// Debe coincidir con TONOS_COMUNICACION (src/constants/profesionales.constants.js) y con el front-end.
enum TonoComunicacion {
  cercano
  formal
  neutro
}

/// Ficha de un profesional: datos de contacto, agenda, honorarios y reglas de mensajes.
/// Relación 1 a 1 con `users` (rol profesional).
model Profesional {
  id                     String           @id @default(uuid())
  userId                 String           @unique @map("user_id")
  especialidad           String?
  matricula              String?
  activo                 Boolean          @default(true)
  /// Honorario base por consulta (pesos).
  honorarioBase          Decimal?         @map("honorario_base") @db.Decimal(12, 2)
  telefono               String?
  modalidades            Modalidad[]      @default([])
  /// Días de atención: 0 = domingo … 6 = sábado.
  diasAtencion           Int[]            @default([]) @map("dias_atencion")
  /// Con cuántas horas de anticipación se le avisa al paciente antes del turno.
  recordatorioHorasAntes Int              @default(24) @map("recordatorio_horas_antes")
  tonoComunicacion       TonoComunicacion @default(neutro) @map("tono_comunicacion")
  /// Token del link de solo lectura que se le comparte al profesional.
  linkToken              String           @unique @map("link_token")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profesionales")
}

model Paciente {
  id                   String   @id @default(uuid())
  nombre               String
  apellido             String
  /// Solo dígitos, sin puntos (ej. "35421980"). Único entre pacientes.
  dni                  String?  @unique
  telefono             String?
  email                String?
  /// Obra social / prepaga y plan (ej. "OSDE 310").
  cobertura            String?
  /// Notas administrativas (preferencias, avisos). Nunca información clínica.
  notasAdministrativas String?  @map("notas_administrativas")
  /// Baja lógica: un paciente inactivo no aparece en los listados por defecto ni puede
  /// recibir turnos nuevos, pero conserva sus datos y su historial de turnos.
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  /// Profesionales asignados (al menos uno; lo valida el back-end).
  /// Si se borra la última asignación, un trigger borra al paciente (ver migración).
  profesionales PacienteProfesional[]
  turnos        Turno[]
  mensajes      Mensaje[]

  @@index([apellido, nombre])
  @@map("pacientes")
}

/// Asignación paciente ↔ profesional (muchos a muchos).
model PacienteProfesional {
  pacienteId    String   @map("paciente_id")
  profesionalId String   @map("profesional_id")
  createdAt     DateTime @default(now()) @map("created_at")

  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profesional User     @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@id([pacienteId, profesionalId])
  @@index([profesionalId])
  @@map("paciente_profesionales")
}

model Turno {
  id            String   @id @default(uuid())
  inicio        DateTime
  fin           DateTime
  notas         String?
  profesionalId String   @map("profesional_id")
  pacienteId    String   @map("paciente_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profesional User     @relation(fields: [profesionalId], references: [id])
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([inicio])
  @@index([profesionalId, inicio])
  @@map("turnos")
}

/// Debe coincidir con TIPOS_MENSAJE (src/constants/mensajes.constants.js) y con el front-end.
enum TipoMensaje {
  recordatorio_turno
  cobro_pendiente
  confirmacion_reserva
}

/// Plantilla de mensaje guardada por Gestión para un tipo y un tono. Si no hay fila para
/// un par (tipo, tono), se usa la plantilla por defecto de `mensajes.constants.js`.
/// El contenido usa marcadores: {nombre}, {paciente}, {profesional}, {fecha}, {hora}.
model PlantillaMensaje {
  id        String           @id @default(uuid())
  tipo      TipoMensaje
  tono      TonoComunicacion
  contenido String
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([tipo, tono])
  @@map("plantillas_mensajes")
}

/// Registro de un mensaje enviado a un paciente (por ahora, por WhatsApp desde la app).
model Mensaje {
  id            String      @id @default(uuid())
  pacienteId    String      @map("paciente_id")
  profesionalId String      @map("profesional_id")
  tipo          TipoMensaje
  /// Texto final enviado (con los datos ya completados).
  contenido     String
  enviadoAt     DateTime    @default(now()) @map("enviado_at")

  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profesional User     @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@index([pacienteId, enviadoAt])
  @@map("mensajes")
}
