# Copiar a `.env` y completar. `.env` no se versiona.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://turnos:CAMBIAR_PASSWORD@localhost:5432/gestion_turnos?schema=public"

# Clave secreta para firmar los tokens de sesión (obligatoria). Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Servidor (opcionales)
# PORT=3000
# CORS_ORIGIN=http://localhost:4200

# Usuarios iniciales que crea `npm run db:seed` (si faltan, ese usuario se omite)
SEED_GESTION_NOMBRE=
SEED_GESTION_EMAIL=
SEED_GESTION_PASSWORD=

SEED_PROFESIONAL_NOMBRE=
SEED_PROFESIONAL_EMAIL=
SEED_PROFESIONAL_PASSWORD=
